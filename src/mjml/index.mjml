
<mjml>
  <mj-head>
    <mj-title>NETGEAR Insider: Wi-Fi Just got Faster</mj-title>
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&amp;display=swap"></mj-font>
    <mj-raw>
      <meta charset="UTF-8">
      <meta name='color-scheme' content='light'/>
      <meta name='supported-color-schemes' content='light'/>
      <meta name="format-detection" content="telephone=no"/>
      <meta name="format-detection" content="date=no"/>
      <meta name="format-detection" content="address=no"/>
      <meta name="format-detection" content="email=no"/>
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans serif"/>
      <mj-class name="T32-300" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="32px" line-height="50px" font-weight="300"/>
      <mj-class name="T25-300" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="25px" line-height="40px" font-weight="300"/>
      <mj-class name="T30-500" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="30px" line-height="40px" font-weight="500"/>
      <mj-class name="T26-500" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="26px" line-height="35px" font-weight="500"/>
      <mj-class name="T17-500" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="17px" line-height="25px" font-weight="500"/>
      <mj-class name="T12-400" font-family="Arial, Helvetica, sans-serif" font-style="normal" font-size="12px" line-height="13px" font-weight="400"/>
      <mj-button padding="0" inner-padding="10px 10px" width="163px" border-radius="20px" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="16px" line-height="20px" font-weight="700" text-transform="uppercase"></mj-button>
      <mj-class name="cT1" color="#2c262d"/>
      <mj-class name="bgT1" background-color="#2c262d"></mj-class>
      <mj-class name="cT0" color="#000000"/>
      <mj-class name="bg0" background-color="#000000"/>
      <mj-class name="cTW" color="#ffffff"/>
      <mj-class name="bgW" background-color="#ffffff"/>
      <mj-class name="cB" color="#00a3de"/>
      <mj-class name="bgB" background-color="#00a3de"/>
    </mj-attributes>
    <mj-breakpoint width="480px"></mj-breakpoint>
  </mj-head>
  <mj-body background-color="#f1f0f0" width="700px">
    <mj-section padding="24px 30px" mj-class="bgT1">
      <mj-group>
        <mj-column vertical-align="middle">
          <mj-image align="left" padding="0" width="145px" src="./images/businessNetgear.png" alt="logo Netgear store en blanc"/>
        </mj-column>
        <mj-column vertical-align="middle">
          <mj-text align="right" padding="0" mj-class="T9-400" color="#ababab" text-transform="uppercase" letter-spacing="2px"><a style="text-decoration:none;color:#ababab;" href="#">version en ligne&nbsp;&#x23f5;</a></mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-image src="/images/illustrationT.jpg" alt=""></mj-image>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-image src="/images/illustrationEve.jpg" alt=""></mj-image>
      </mj-column>
      <mj-column>
        <mj-text>Webinar</mj-text>
        <mj-text>Durant ce webinar, Netgear vous propose de découvrir :</mj-text>
        <mj-text>Les points d'accès Netgear WiFi 6 et systèmes Mesh Orbi Pro WiFi 6</mj-text>
        <mj-text>Comment faire... Netgear Instant Mesh</mj-text>
        <mj-text>Comment faire... Netgear Orbi Pro</mj-text>
        <mj-text>Comparaison Netgear Orbi vs Netgear Instant Mesh</mj-text>
        <mj-text>Questions et réponses</mj-text>
        <mj-text><img src="./images/agenda.png" alt=""/>Jeudi 15 Juillet</mj-text>
        <mj-divider></mj-divider>
        <mj-text><img src="./images/temps.png" alt=""/>11h30</mj-text>
        <mj-divider></mj-divider>
        <mj-text><img src="./images/sablier.png" alt=""/>30 minutes</mj-text>
        <mj-divider></mj-divider>
        <mj-text><img src="./images/reunion.png" alt=""/>Public non technique, pour comprendre les avantages du WiFi 6 en entreprise</mj-text>
        <mj-button>Je m'inscris</mj-button>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text><img src="./images/iconLieu.png" alt=""/>Netgear - 2 rue de Marly le roi, 78150 Le Chesnay</mj-text>
        <mj-social>
          <mj-social-element src="./images/facebookIcon.png" href="https://www.facebook.com/netgearfrance"></mj-social-element>
          <mj-social-element src="./images/twitterIcon.png" href="https://twitter.com/NetgearFrance"></mj-social-element>
          <mj-social-element src="./images/linkedinIcon.png" href="https://www.linkedin.com/company/netgear-france"></mj-social-element>
          <mj-social-element src="./images/youtubeIcon.png" href="https://www.youtube.com/user/NETGEARFrance"></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>