
<mjml>
  <mj-head>
    <mj-title>NETGEAR Insider: Wi-Fi Just got Faster</mj-title>
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&amp;display=swap"></mj-font>
    <mj-raw>
      <meta charset="UTF-8">
      <meta name='color-scheme' content='light'/>
      <meta name='supported-color-schemes' content='light'/>
      <meta name="format-detection" content="telephone=no"/>
      <meta name="format-detection" content="date=no"/>
      <meta name="format-detection" content="address=no"/>
      <meta name="format-detection" content="email=no"/>
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans serif"/>
      <mj-class name="T32-300" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="32px" line-height="50px" font-weight="300"/>
      <mj-class name="T25-300" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="25px" line-height="40px" font-weight="300"/>
      <mj-class name="T30-500" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="30px" line-height="40px" font-weight="500"/>
      <mj-class name="T24-600" font-family="Arial, Helvetica, sans-serif" font-style="normal" font-size="24px" line-height="28px" font-weight="600"/>
      <mj-class name="T14-400" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="14px" line-height="20px" font-weight="400"/>
      <mj-button padding="0" inner-padding="10px 10px" width="163px" border-radius="20px" font-family="&quot;Source Sans 3&quot;, Arial, Helvetica, sans-serif" font-style="normal" font-size="16px" line-height="20px" font-weight="700" text-transform="uppercase"></mj-button>
      <mj-class name="cT1" color="#2c262d"/>
      <mj-class name="bgT1" background-color="#2c262d"></mj-class>
      <mj-class name="cT0" color="#000000"/>
      <mj-class name="bg0" background-color="#000000"/>
      <mj-class name="cTW" color="#ffffff"/>
      <mj-class name="bgW" background-color="#ffffff"/>
      <mj-class name="cB" color="#73389b"/>
      <mj-class name="bgB" background-color="#73389b"/>
    </mj-attributes>
    <mj-breakpoint width="480px"></mj-breakpoint>
  </mj-head>
  <mj-body background-color="#f1f0f0" width="700px">
    <mj-section padding="24px 30px" mj-class="bgT1">
      <mj-group>
        <mj-column vertical-align="middle">
          <mj-image align="left" padding="0" width="145px" src="./images/businessNetgear.png" alt="logo Netgear store en blanc"/>
        </mj-column>
        <mj-column vertical-align="middle">
          <mj-text align="right" padding="0" mj-class="T9-400" color="#ababab" text-transform="uppercase" letter-spacing="2px"><a style="text-decoration:none;color:#ababab;" href="#">version en ligne&nbsp;&#x23f5;</a></mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section padding="0">
      <mj-column width="700px">
        <mj-image padding="0" width="700px" src="/images/illustrationT.jpg" alt=""></mj-image>
      </mj-column>
    </mj-section>
    <mj-section padding="0" mj-class="bgW">
      <mj-column width="50%">
        <mj-image padding="0" width="348px" src="/images/illustrationEve.jpg" alt=""></mj-image>
      </mj-column>
      <mj-column width="50%" padding="20px 30px 10px 20px">
        <mj-text padding="0" padding-bottom="15px" mj-class="T24-600 cB" letter-spacing="1.5px">Webinar</mj-text>
        <mj-text padding="0" padding-bottom="20px" mj-class="T14-400 cT0">Durant ce webinar, Netgear vous propose de découvrir :</mj-text>
        <mj-text padding="0" padding-bottom="10px" mj-class="T14-400 cT0">&#x2022;&nbsp;&nbsp;&nbsp;Les points d'accès <strong>NETGEAR WiFi 6</strong> et systèmes Mesh Orbi Pro WiFi 6</mj-text>
        <mj-text padding="0" padding-bottom="10px" mj-class="T14-400 cT0">&#x2022;&nbsp;&nbsp;&nbsp;Comment faire... <strong>NETGEAR Instant Mesh</strong></mj-text>
        <mj-text padding="0" padding-bottom="10px" mj-class="T14-400 cT0">&#x2022;&nbsp;&nbsp;&nbsp;Comment faire... <strong>NETGEAR Orbi Pro</strong></mj-text>
        <mj-text padding="0" padding-bottom="10px" mj-class="T14-400 cT0">&#x2022;&nbsp;&nbsp;&nbsp;<strong>Comparaison</strong> NETGEAR Orbi vs NETGEAR Instant Mesh</mj-text>
        <mj-text padding="0" padding-bottom="10px" mj-class="T14-400 cT0">&#x2022;&nbsp;&nbsp;&nbsp;<strong>Questions</strong> et <strong>réponses</strong></mj-text>
        <mj-table padding="10px 0">
          <tr>
            <td width="10%"><img style="vertical-align:middle;padding:0" width="40px" src="./images/agenda.png" alt=""/></td>
            <td width="90%" style="padding-left:10px;align:left;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-style:normal;font-size:14px;line-height:20px;font-weight:400;">Jeudi 15 Juillet</td>
          </tr>
        </mj-table>
        <mj-divider padding="0" border-width="1px" border-style="solid" border-color="#cccccc"></mj-divider>
        <mj-table padding="10px 0">
          <tr>
            <td width="10%"><img style="vertical-align:middle;padding:0" width="40px" src="./images/temps.png" alt=""/></td>
            <td width="90%" style="padding-left:10px;align:left;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-style:normal;font-size:14px;line-height:20px;font-weight:400;">11h30</td>
          </tr>
        </mj-table>
        <mj-divider padding="0" border-width="1px" border-style="solid" border-color="#cccccc"></mj-divider>
        <mj-table padding="10px 0">
          <tr>
            <td width="10%"><img style="vertical-align:middle;padding:0" width="40px" src="./images/sablier.png" alt=""/></td>
            <td width="90%" style="padding-left:10px;align:left;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-style:normal;font-size:14px;line-height:20px;font-weight:400;">30 minutes</td>
          </tr>
        </mj-table>
        <mj-divider padding="0" border-width="1px" border-style="solid" border-color="#cccccc"></mj-divider>
        <mj-table padding="10px 0">
          <tr>
            <td width="10%"><img style="vertical-align:middle;padding:0" width="40px" src="./images/reunion.png" alt=""/></td>
            <td width="90%" style="padding-left:10px;align:left;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-style:normal;font-size:14px;line-height:20px;font-weight:400;">Public non technique, pour comprendre les avantages du WiFi 6 en entreprise</td>
          </tr>
        </mj-table>
        <mj-spacer height="20px"></mj-spacer>
        <mj-button mj-class="bgB">Je m'inscris</mj-button>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text vertical-align="middle" align="center" padding="0" mj-class="T14-400 cT0"><img style="vertical-align:middle;padding:0" width="10px" src="./images/iconLieu.png" alt=""/> 
          &nbsp;<span style="text-transform:uppercase"> Netgear</span> - 2 rue de Marly le roi, 78150 <span style="text-transform:uppercase">Le Chesnay</span>
        </mj-text>
        <mj-social padding="0" icon-size="32px" mode="horizontal">
          <mj-social-element src="./images/facebookIcon.png" href="https://www.facebook.com/netgearfrance"></mj-social-element>
          <mj-social-element src="./images/twitterIcon.png" href="https://twitter.com/NetgearFrance"></mj-social-element>
          <mj-social-element src="./images/linkedinIcon.png" href="https://www.linkedin.com/company/netgear-france"></mj-social-element>
          <mj-social-element src="./images/youtubeIcon.png" href="https://www.youtube.com/user/NETGEARFrance"></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>